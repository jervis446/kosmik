{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kosmik",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // The web app (Expo web export) is served by this Worker; /api/* runs the code and / is the
  // landing page (app/public/landing.html). The app itself lives at /chat.
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/"]
  },

  // Production database (created with: npx wrangler d1 create kosmik --location apac)
  "d1_databases": [{ "binding": "DB", "database_name": "kosmik", "database_id": "073d7c72-530a-4e07-a2f2-e8dd5b8ce4f4", "migrations_dir": "migrations" }],

  // Optional, for many cached answers: npx wrangler vectorize create kosmik --dimensions=768 --metric=cosine
  // then uncomment and run data/scripts/push-vectorize.ts. Without it, vectors are searched in memory.
  // "vectorize": [{ "binding": "VECTORS", "index_name": "kosmik" }],

  // Daily clean-up of old counts, chats and unused cached answers (src/retention.ts): 03:00 India time.
  "triggers": { "crons": ["30 21 * * *"] },

  // 20 write requests a minute per IP address.
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } }],

  // SUPABASE_URL, SUPABASE_ANON_KEY (Asanoha sign-in; public values), GUEST_SALT and GEMINI_API_KEY (secrets):
  // local development reads them from .dev.vars; production: npx wrangler secret put <NAME>.
  "vars": {
    "CHAT_MODEL": "gemini-3.5-flash",
    // The web app is also served from GitHub Pages at this address and calls the API from there.
    "ALLOWED_ORIGINS": "https://kosmik.asanoha.co.in"
  }
}
