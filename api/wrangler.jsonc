{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kosmik",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // The web app (Expo web export) is served by this Worker; /api/* runs the code.
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "ai": { "binding": "AI" },

  // Create with: npx wrangler d1 create kosmik   (then put the id it prints here)
  "d1_databases": [{ "binding": "DB", "database_name": "kosmik", "database_id": "local-development", "migrations_dir": "migrations" }],

  // Optional, for many cached answers: npx wrangler vectorize create kosmik --dimensions=1024 --metric=cosine
  // then uncomment and run data/scripts/push-vectorize.ts. Without it, vectors are searched in memory.
  // "vectorize": [{ "binding": "VECTORS", "index_name": "kosmik" }],

  // 20 write requests a minute per IP address.
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } }],

  // SUPABASE_URL, SUPABASE_ANON_KEY (Asanoha sign-in; public values) and GUEST_SALT (secret):
  // local development reads them from .dev.vars; production: npx wrangler secret put <NAME>.
  "vars": { "CHAT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast" }
}
