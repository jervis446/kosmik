# Kosmik production secrets. Fill these in on your own computer, never in a chat.
#
# 1. Copy this file:      cp secrets.env.example .env.secrets      (.env.secrets is git-ignored)
# 2. Paste the values after each "=" (no quotes, no spaces).
# 3. Upload them all:     npx wrangler secret bulk .env.secrets
# 4. Delete the copy:     rm .env.secrets
# Leave a line empty, or remove it, to keep that secret as it is. They take effect within seconds.

# ---- Noha Pay (Premium payments by UPI). Payments switch on when all three are set.
# Gateway: the live checkout, e.g. https://pay.peoplepitchers.com
NOHA_GATEWAY_URL=
# Kosmik's own merchant id and key from the Noha Pay dashboard (not People Pitchers' or Wearday's).
NOHA_MERCHANT_ID=
NOHA_MERCHANT_KEY=
# Only if Noha Pay signs webhooks with a separate secret; otherwise the merchant key is used.
NOHA_WEBHOOK_SECRET=
# Webhook to set in Noha Pay for this merchant: https://kosmik.prime-adarsh108.workers.dev/api/pay/webhook

# ---- WhatsApp codes (one verified number per account).
# The relay's public HTTPS address. Kosmik sends POST {"to": "91XXXXXXXXXX", "text": "..."}
# with the header "Authorization: Bearer <WA_RELAY_TOKEN>". The nohapay-wa relay listens on
# port 6200 on the Noha Pay server, so it needs a public hostname through the Cloudflare tunnel.
WA_RELAY_URL=
WA_RELAY_TOKEN=
# Set to 1 only after a test code has arrived on WhatsApp: from then on everyone must verify a number.
PHONE_REQUIRED=
